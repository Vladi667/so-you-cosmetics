{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verifier-traductions.mjs && node scripts/verifier-seo.cjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "install-all": "npm install && npm install --prefix server",
    "dev:fullstack": "concurrently \"npm run dev\" \"npm run start --prefix server\"",
    "start": "node server/index.js",
    "verifier:traductions": "node scripts/verifier-traductions.mjs",
    "verifier:seo": "node scripts/verifier-seo.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^8.0.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
